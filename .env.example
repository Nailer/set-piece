# Aholo API key from https://labs.aholo.ai/api-keys. Without it the game still runs; forging is switched off.
AHOLO_API_KEY=
AHOLO_REGION=com
# Where sets, games and generated files are stored. Point it at a persistent disk in production.
DATA_DIR=
# Lets the owner forge house sets without the daily limits.
ADMIN_TOKEN=
MAX_SETS_PER_DAY=8
